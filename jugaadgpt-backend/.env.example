# ── JugaadGPT backend configuration ─────────────────────────────
# Copy to .env and fill in. Every provider below has a free tier —
# nothing here costs money.
#
# PRIMARY DEPLOY TARGET: Render (web service) + Supabase (Postgres/Auth)
# + Upstash (Redis) + Vercel (frontends). See docs/DEPLOY.md.

# ── Database ──
# Supabase: use the SESSION pooler (port 5432) for Alembic/scripts and the
# TRANSACTION pooler (port 6543) for the running app. Pooler quirks
# (statement cache off, unique prepared-statement names) are handled
# automatically when the host contains pooler.supabase.com.
#
# App (transaction pooler, 6543):
#   DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Alembic/scripts (session pooler, 5432):
#   DATABASE_URL_SYNC=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql+asyncpg://jugaad:jugaad_secret@localhost:5432/jugaadgpt
DATABASE_URL_SYNC=postgresql://jugaad:jugaad_secret@localhost:5432/jugaadgpt
POSTGRES_PASSWORD=jugaad_secret   # only used by the docker-compose (Oracle) path

# ── Redis (quota counters + provider exhaustion flags) ──
# Upstash: copy the rediss:// URL (TLS) from the Upstash console.
# Leave empty for local dev (in-memory fallback — quotas reset on restart;
# the app logs a loud warning if production starts without Redis).
REDIS_URL=

# ── Free-tier LLM providers (fallback chain: groq → gemini → openrouter) ──
GROQ_API_KEY=            # console.groq.com — also powers Whisper transcription
GEMINI_API_KEY=          # aistudio.google.com/apikey — also powers embeddings
OPENROUTER_API_KEY=      # openrouter.ai/keys (free models only)

# ── Embeddings ──
# gemini (default): Google text-embedding-004 via GEMINI_API_KEY, 768 dims.
#                   No torch → fits small Render web services.
# local:            sentence-transformers on the server. Install with
#                   `poetry install --extras local-embeddings`. 384 dims default.
# EMBEDDING_DIM=0 means auto (768 for gemini, 384 for local).
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=0

# ── Supabase Auth (frontend logs in; backend only verifies the JWT) ──
SUPABASE_URL=            # https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=       # Settings → API → anon public key (used by frontends)
SUPABASE_JWT_SECRET=     # Settings → API → JWT Secret (HS256 verification)

# ── Daily quotas (generator runs only; clarifying turns are free) ──
FREE_DAILY_QUOTA=5       # anonymous, per device-id / per IP
AUTH_DAILY_QUOTA=25      # logged-in, per user
WA_DAILY_QUOTA=5         # WhatsApp, per phone number

# ── Meta WhatsApp Cloud API (optional, skip for now) ──
WHATSAPP_VERIFY_TOKEN=jugaadgpt_verify
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── Gemini Imagen blueprint images (optional, cookie-based) ──
GEMINI_COOKIE=

# ── Observability (optional) ──
SENTRY_DSN=              # backend Sentry project DSN; empty = disabled

# Keep-alive (Render free web service)
# Render injects RENDER_EXTERNAL_URL automatically. Set KEEPALIVE_URL only if
# you want to override it, or if you are running on another host.
KEEPALIVE_ENABLED=true
KEEPALIVE_URL=
KEEPALIVE_INTERVAL_SECONDS=600

# ── Deployment ──
# Render injects PORT automatically; WEB_CONCURRENCY defaults to 1 worker.
DOMAIN=api.yourdomain.com        # only used by the Caddy (Oracle) path
ENVIRONMENT=production
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://<webapp>.vercel.app,https://<landing>.vercel.app,https://app.yourdomain.com,https://yourdomain.com
