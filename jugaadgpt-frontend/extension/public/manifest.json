{
  "manifest_version": 3,
  "name": "JugaadGPT",
  "version": "1.0",
  "description": "Grassroots engineering context pill and search assistant.",
  "action": {
    "default_popup": "index.html",
    "default_title": "JugaadGPT Workspace"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "sidePanel",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:8000/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
