{
  "manifest_version": 3,
  "name": "JugaadGPT",
  "version": "1.0",
  "description": "Grassroots engineering context pill and search assistant.",
  "action": {
    "default_popup": "index.html",
    "default_title": "JugaadGPT Workspace"
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
